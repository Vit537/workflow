# Dos API keys de Groq. Ahora funcionan con FAILOVER automático:
# si una se queda sin tokens / supera el límite, el servicio reintenta con la otra.
#   - Los diagramas prefieren POLICY (y caen a CHAT si falla).
#   - Chat y reportes prefieren CHAT (y caen a POLICY si falla).
GROQ_API_KEY_POLICY=your_groq_api_key_policy_here
GROQ_API_KEY_CHAT=your_groq_api_key_chat_here

# Modelos (opcionales; estos son los valores por defecto)
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_MODEL_REPORTE=llama-3.3-70b-versatile
# GROQ_MODEL_CHAT=llama-3.3-70b-versatile
# GROQ_MODEL_WHISPER=whisper-large-v3-turbo

ALLOWED_ORIGINS=http://localhost:4200
